# =====================================================================
# CycleCare — Supabase Environment Configuration Example
# =====================================================================

# Server Port (default: 3000)
PORT=3000

# 1. Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Public Anon Key (found in Supabase Dashboard -> Project Settings -> API)
# SECURITY NOTICE: ONLY provide the public 'anon' key here.
# NEVER expose or use the 'service_role' secret key in client code!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================================
# Upstream SMS Provider Configuration (SMS-BUS Official API)
# Documented APIs: https://sms-bus.com/docs & https://sms-bus.com/docs/rent
# =====================================================================
# SMS-BUS Account API Token (found in SMS-BUS Profile)
# SECURITY NOTICE: Stored strictly server-side. NEVER exposed in client /env.js.
SMSBUS_API_TOKEN=your_smsbus_api_token_here

# Active SMS Provider ('smsbus', or extensible secondary suppliers)
SMS_ACTIVE_PROVIDER=smsbus

# Enforce strict production mode (rejects mock availability / fake SMS)
SMS_STRICT_PRODUCTION=true
