# =====================================================================
# CycleCare — Supabase Environment Configuration Example
# =====================================================================

# Server Port (default: 3000)
PORT=3000

# 1. Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Public Anon Key (found in Supabase Dashboard -> Project Settings -> API)
# SECURITY NOTICE: ONLY provide the public 'anon' key here.
# NEVER expose or use the 'service_role' secret key in client code!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
